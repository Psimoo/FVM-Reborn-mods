// 战斗房间开始（obj_battle 的 Room Start）调用：只预热当前卡组带进来的卡。
// 不一次性生成，而是排队后每帧生成一小批（obj_pool_prewarm_tick），避免进关瞬间卡顿。
function obj_pool_prewarm_deck() {
    if (!variable_global_exists("_obj_pool_ready") || !global._obj_pool_ready) obj_pool_init();
    if (!variable_global_exists("obj_pool_deck_prewarm")) global.obj_pool_deck_prewarm = 25;
    if (!variable_global_exists("obj_pool_prewarm_per_frame")) global.obj_pool_prewarm_per_frame = 8;

    global._obj_pool_prewarm_queue = []; // 重置队列

    var _count = global.obj_pool_deck_prewarm;
    if (_count <= 0) return;
    if (!variable_global_exists("_obj_pool_deck_map")) global._obj_pool_deck_map = obj_pool_build_deck_map();
    if (!variable_global_exists("selected_deck")) return;

    var _done = ds_map_create();
    for (var i = 0; i < ds_list_size(global.selected_deck); i++) {
        var _e = global.selected_deck[| i];
        if (!ds_exists(_e, ds_type_map)) continue;
        if (!ds_map_exists(_e, "data")) continue;
        var _data = _e[? "data"];
        if (!ds_exists(_data, ds_type_map)) continue;
        if (!ds_map_exists(_data, "obj")) continue;
        var _plant = _data[? "obj"];
        if (!is_real(_plant) || _plant < 0) continue;
        var _name = object_get_name(_plant);
        if (!variable_struct_exists(global._obj_pool_deck_map, _name)) continue;
        var _bullets = global._obj_pool_deck_map[$ _name];
        for (var j = 0; j < array_length(_bullets); j++) {
            var _b = _bullets[j];
            if (!is_real(_b) || _b < 0) continue;
            var _bk = string(_b);
            if (ds_map_exists(_done, _bk)) continue;
            ds_map_add(_done, _bk, true);
            array_push(global._obj_pool_prewarm_queue, [_b, _count]);
        }
    }
    ds_map_destroy(_done);
    obj_pool_prewarm_tick(); // 本帧先做一批
}

// 每帧生成一小批空壳（obj_battle 的 End Step 调用），避免单帧峰值
function obj_pool_prewarm_tick() {
    if (!variable_global_exists("_obj_pool_prewarm_queue") || !is_array(global._obj_pool_prewarm_queue)) return;
    var _q = global._obj_pool_prewarm_queue;
    var _budget = global.obj_pool_prewarm_per_frame;
    for (var i = array_length(_q) - 1; i >= 0 && _budget > 0; i--) {
        var _item = _q[i];
        obj_pool_prealloc(_item[0], 1);
        _item[1] -= 1;
        _budget -= 1;
        if (_item[1] <= 0) array_delete(_q, i, 1);
    }
    if (array_length(_q) == 0) global._obj_pool_prewarm_queue = [];
}
