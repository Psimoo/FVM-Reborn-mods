function mod_info_island_init()
{
    // 护法神
    register_card_info_island("hufa_god", "[分类：喷壶类]\n基础能力：全屏索敌追踪穿透弹，攻击陆、空鼠军，\n秒杀不防爆鼠，15%概率定身1.5秒，命中后继续直线飞出。\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n三转能力：攻击力提升，魂系老鼠1.8倍伤害。\n\n四转能力：追加地鼠目标，攻击力大幅提升。\n\n终转能力：对BOSS造成2倍伤害。");
    register_card_info_island("gaia", "[分类：追踪类]\n基础能力：当自身三行内出现敌人时，每隔[攻击间隔]秒，就会发射两枚\n毁灭巨石，在本行对应的敌人位置造成3*3范围的灰烬爆炸效果，造成\n[攻击力]点伤害。\n *星级影响[攻击间隔]，技能影响[冷却时间]。\n\n三转能力：攻击力提高，眩晕并初始瞬发。\n\n四转能力：增加1发子弹。\n\n终转能力：索敌范围扩大至自身中心5行，爆炸范围扩大至5x5。");
    register_card_info_island("aurora", "[分类：增幅类]\n基础能力：为本行投掷类卡片增伤,倍率为[攻击力]/100。\n *星级影响[攻击力]，技能影响[冷却时间]。\n\n三转能力：死亡后造成3x3爆炸。\n\n四转能力：[攻击力]额外增加30%。\n\n终转能力：增伤范围提升至三行，非本行加成为原来的20%。");
    register_card_info_island("zhurong", "[分类：投掷类]\n基础能力：当前方攻击范围内出现敌人时，每隔[攻击间隔]秒，就会投出\n高温n球，点燃身前3x3的地面，对上面的敌人持续造成[攻击力]的伤害。\n-祝融的射程为4格\n-每发子弹总计造成10次[攻击力]的伤害\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n三转能力：[攻击力]额外提升30%，射程增加一格。\n\n四转能力：点燃范围扩大到5x5。\n\n终转能力：[攻击力]额外提升45%，点燃范围扩大到7x5。");
    register_card_info_island("rig", "[分类：五向类]\n基础能力：当前方出现敌人时，每隔[攻击间隔]秒，就会向前方5个方向\n发射穿透子弹，对穿过的敌人造成[攻击力]的伤害。\n -场上每存在一个里格，自身的[能量消耗]就会增加50点。\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n三转能力：[攻击力]额外提升10%，能量守恒。\n\n四转能力：攻击力根据场上里格的数量提升。\n\n终转能力：攻击力翻倍。");
    register_card_info_island("brahma", "[分类：增幅类]\n基础能力：在3x3范围内复制两张上一次放下的卡片，优先选择中心和上下\n两格。\n *星级影响[冷却时间]，技能无影响。\n\n三转能力：放置造成5x5灰烬爆炸。\n\n四转能力：额外复制一张卡片。\n\n终转能力：再额外复制两张卡片，共5张。");
    register_card_info_island("baibianshe", "[分类：增幅类]\n基础能力：变身成为5x5范围内上一张种下的卡片，复制类卡片无法变身。\n *星级影响[冷却时间]，技能影响[攻击间隔]。\n\n一转能力：变身范围扩大到全屏。\n\n二转能力：变身数量+2，共3张。");
    register_card_info_island("clotho", "[分类：增幅类]\n基础能力：放下后一段时间为3x3范围内的所有卡片随机提高或降低星级，\n最高16星，最低0星。\n *星级影响[冷却时间]，技能无影响。\n\n三转能力：优化升星概率，必定升星。\n\n四转能力：优化升星概率，影响范围扩大到5x5。\n\n终转能力：优化升星概率，影响范围扩大到5x7。");
    register_card_info_island("time_god", "[分类：增幅类]\n基础能力：种卡之后一段时间内，持续给3x3范围内的卡片缩短冷却时间30%。\n技能影响的是持续作用的时间，种卡之后[攻击间隔]内，持续[技能等级]次数，5等级4次，8等级5次，\n *星级影响[冷却时间]，技能影响[冷却时间]。\n\n三转能力：放卡产生爆炸，对附近敌人造成伤害。\n\n四转能力：范围扩大至5x5，冷却缩减50%。\n\n终转能力：范围扩大至全屏，冷却缩减100%。");
    register_card_info_island("warm_birds", "[分类：产能类]\n基础能力：放置1秒后立即生产三朵价值为[火苗产量]的火苗，随后每隔[攻\n击间隔]秒，就会产出三朵火苗。\n *星级影响[攻击间隔]，技能影响[火苗产量]。\n\n一转能力：一次可产出四朵火苗。\n\n二转能力：一次可产出五朵火苗，冷却时间减半。");
    register_card_info_island("cold_drew", "[分类：追踪类]\n基础能力：当场上出现敌人时，每隔[攻击间隔]秒根据敌人数量发射至多四\n颗冰块子弹打击敌人，对敌人造成[攻击力]的伤害。\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n一转能力：可以发射的子弹增加一枚，每颗子弹获得20%溅射。\n\n二转能力：固定发射6枚冰块子弹，可集火。");
    register_card_info_island("berry_dessert", "[分类：增幅类]\n基础能力：为自身周围3x3范围内的追踪类卡片增伤，倍率为[攻击力]/100。\n *星级影响[攻击力]，技能影响[冷却时间]。\n\n一转能力：增伤范围扩大至5x5。\n\n二转能力：[攻击力]固定增加30。");
    register_card_info_island("grilled_lizard_pult", "[分类：投掷类]\n基础能力：当前方一行出现敌人时，每隔[攻击间隔]秒，就会投掷一个爆弹，\n爆弹会对主目标造成等同于[攻击力]的伤害，并对3*3范围内的其他目标造\n成35%的溅射伤害。\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n一转能力：[攻击力]额外增加45%。\n\n二转能力：每次攻击可投掷两个爆弹。");
    register_card_info_island("blueberry_tower", "[分类：增幅类]\n基础能力：为本行投掷类卡片增伤,倍率为[攻击力]/100。\n *星级影响[攻击力]，技能影响[冷却时间]。");
    register_card_info_island("donut", "[分类：直线类]\n基础能力：当前方一行出现敌人时，每隔[攻击间隔]秒，就会根据敌人类型\n连续发射两颗对空/对地甜甜圈子弹，甜甜圈子弹会穿过障碍，对敌人造成\n等同于[攻击力]的伤害。\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n一转能力：[能量消耗]子弹附加3x3范围25%溅射。\n\n二转能力：每次攻击额外射出一发子弹。");
    register_card_info_island("spoon_rabbit", "[分类：投掷类]\n基础能力：当前方三行出现敌人时，每隔[攻击间隔]秒，就会投掷三颗爆\n炸萝卜，每行一颗，爆炸萝卜会对主目标造成等同于[攻击力]的伤害，并\n对3*3范围内的其他目标造成35%的溅射伤害。\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n一转能力：中路额外增加一发子弹，共4发。\n\n二转能力：侧路额外增加两发子弹，共6发。");
    register_card_info_island("firework_dragon_real", "[分类：产能类]\n基础能力：放下后经过[准备时间]产出6朵价值[火苗产量]的火苗。\n *星级影响[火苗产量]，技能影响[准备时间]。\n\n一转能力：放下后立刻返还种植消耗的火苗。\n\n二转能力：额外产出6朵火苗。");
    register_card_info_island("hspeed_juicer", "[分类：增幅类]\n基础能力：为自身周围3x3范围内的喷壶类卡片增伤，倍率为[攻击力]/100。\n *星级影响[攻击力]，技能影响[冷却时间]。\n\n一转能力：[攻击力]固定增加25。\n\n二转能力：增伤范围扩大至5x5。");
    register_card_info_island("shuangzi", "[分类：产能类]\n基础能力：放置后生产四朵价值为[火苗产量]的火苗，随后每隔[攻\n击间隔]秒，就会产出四朵火苗。\n *星级影响[攻击间隔]，技能影响[火苗产量]。\n\n一转能力：冷却时间减少。\n\n二转能力：一次可产出六朵火苗，冷却时间减少。");
    register_card_info_island("sheshou", "[分类：直线类]\n基础能力：同时向正前方三行发射4发强力箭，中间2发，两边各1发\n，威力巨大！\n*星级影响[攻击力]，技能影响[攻击间隔]。\n\n一转能力：能量守恒(不＋)。\n\n二转能力：攻击次数增加，每次攻击向前方三行各射\n出2发（共6发）强力子弹。");
    register_card_info_island("athena", "[分类：追踪类]\n基础能力：普通能力：高频率发射激光武器，全屏跟踪轰炸，强力范围伤害。\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n一转能力：能量守恒（不+）。\n\n二转能力：连射两发激光。");
    register_card_info_island("tiancheng", "[分类：直线类]\n基础能力：对前后各发射3发强力子弹，威力与实力的象征。\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n一转能力：能量守恒（不+）。\n\n二转能力：前后各增加1发子弹。");
    register_card_info_island("shuangyu", "[分类：投掷类]\n基础能力：投掷两发强力冰鱼并产生溅射伤害40%,威力强大。\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n一转能力：能量守恒，[能量消耗]不再增加。\n\n二转能力：子弹威力提升35%。");
    register_card_info_island("juxie", "[分类：追踪类]\n基础能力：扔出4发强力大钳子，全屏跟踪，无死角攻击。\n -巨蟹座可以放置在陆地和水面上。\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n一转能力：能量守恒（不+）。\n\n二转能力：增加2发子弹。");
    register_card_info_island("shizi", "[分类：喷壶类]\n基础能力：连续快速向周边发出猛烈攻击，海陆空交通管制。\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n一转能力：能量守恒（不+）。\n\n二转能力：范围威力增加25%。");
    register_card_info_island("jinniu", "[分类：增幅类]\n基础能力：凡是穿透它能变成火弹的子弹，威力伤害超强提升，冰弹除外。\n *星级影响[攻击提升倍率]，技能影响[冷却时间]。\n\n一转能力：耗能减少50。\n\n二转能力：威力增加12%");
    register_card_info_island("chunv", "[分类：防御类]\n基础能力：保护被他罩住的卡片，对啃它的老鼠造成一定伤害，体力更高。\n *星级影响[生命值]，技能影响[冷却时间]。\n\n一转能力：爆破伤害增加30%。\n\n二转能力：爆破范围增加到5*5");
    register_card_info_island("baiyang", "[分类：炸弹类]\n基础能力：释放一只白羊精灵，对陆地上的小老鼠造成毁灭性伤害。\n *星级影响[冷却时间]，技能影响[攻击力]。\n\n一转能力：降低能耗至200点。\n\n二转能力：增加上下两行，对三行鼠军造成伤害");
    register_card_info_island("mojie", "[分类：喷壶类]\n基础能力：对范围内造成巨大冰暴伤害，老鼠持续减速扣血，卡片存在一定\n时间后消失。\n *星级影响[攻击力]，技能影响[冷却时间]。\n\n一转能力：[攻击间隔]减半。\n\n二转能力：增加攻击范围");
    register_card_info_island("corn_shooter", "[分类：直线类]\n基础能力：当前方一行内出现敌人时，就会每隔[攻击间隔]秒直线发射三颗\n伤害为[攻击力]的玉米（可过火）。\n *星级影响[攻击力]，技能影响[冷却时间]。\n\n一转能力：增加三发子弹且能量守恒（不+）。\n\n二转能力：子弹威力增加30%。");
    register_card_info_island("sun_god", "[分类：产能类]\n基础能力：产能突破极限，每隔一段\n[攻击间隔]产出6朵火苗，放置后立即生产。\n *星级影响[攻击间隔]，技能影响[火苗产量]。\n\n三转能力：一次生产8朵火苗，冷却与耗火略微降低。\n\n四转能力：一次生产10朵火苗，冷却与耗火进一步降低。\n\n终转能力：一次生产12朵火苗，冷却与耗火大幅降低，首次产量翻倍");
    register_card_info_island("moon_god", "[分类：追踪类]\n基础能力：连续发射6发全屏追踪型攻击的子弹，海陆空兼顾。\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n三转能力：增加1发子弹。\n\n四转能力：每组首发的子弹变身超级子弹,\n超级子弹拥有200%伤害并对3×3范围内敌人造成75%溅射。\n\n终转能力：增加一发子弹，场上每个月神增加5%伤害，最高至145%");
    register_card_info_island("war_god", "[分类：直线类]\n基础能力：前后方分别同时发射4发强力子弹，一共8发。\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n三转能力：前后增加1发子弹。\n\n四转能力：前方每四轮额外射出一发超级子弹，超级子弹拥有800%攻击力。\n\n终转能力：后方每四轮也额外射出一发超级子弹，超级子弹拥有1200%攻击力");
    register_card_info_island("hera", "[分类：防御类]\n基础能力：保护被罩的卡片，反伤啃咬它的老鼠，消失后对5×5范围造成\n一次等同剩余生命值的物理伤害与等同最大生命值的爆炸伤害。\n *星级影响[生命值]，技能影响[冷却时间]。\n\n三转能力：增加25%体力。\n\n四转能力：给被保护的卡片增加1000体力。\n\n终转能力：一次种植3个，优先正上与正下方");
    register_card_info_island("thor", "[分类：投掷类]\n基础能力：连续发出2发带有强力溅射伤害40%和减速效果的冰锤。\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n三转能力：增加1发冰锤，但攻击力降低，总伤害增加20%。\n\n四转能力：溅射伤害提升至45%，每3轮额外投出1发超级子弹，\n超级子弹拥有200%伤害。\n\n终转能力：每轮增加一发超级子弹，溅射伤害提升至100%");
    register_card_info_island("poseidon", "[分类：喷壶类]\n基础能力：连续向周围5*5格发出2发水波攻击，范围伤害能力高度提升。\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n三转能力：攻击力提升20%并附加减速效果。\n\n四转能力：增加1发水波攻击。\n\n终转能力：范围提升至7×5，总伤害提升85%");
    register_card_info_island("love_god", "[分类：直线类]\n基础能力：向正前方三行分别射出2发子弹，一共6发。\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n三转能力：中路增加1发子弹。\n\n四转能力：侧路各增加1发子弹。\n\n终转能力：每四轮额外发射三发超级子弹，\n超级子弹拥有300%伤害，且可穿透敌人与障碍");
    register_card_info_island("zeus", "[分类：追踪类]\n基础能力：全屏发射两发强力闪电攻击，造成3×3强力范围伤害。\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n三转能力：攻击力提升20%。\n\n四转能力：增加一发闪电。\n\n终转能力：增加两发闪电，范围变为5×5。");
    register_card_info_island("ghost_god", "[分类：五向类]\n基础能力：向五个方向分别发射一枚强力子弹。\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n三转能力：增加一发附带减速和穿透的次级子弹，但伤害仅有20%。\n\n四转能力：次级子弹攻击力翻倍（40%）。\n\n终转能力：所有子弹变为次级子弹，但次级子弹现在拥有100%伤害。");
    register_card_info_island("ice_god", "[分类：追踪类]\n基础能力：召唤冰晶，攻击全屏8个敌人，附加减速。\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n三转能力：耗能减少，冰晶带有3*3的40%溅射伤害。\n\n四转能力：攻击力提升，攻击数量+2。\n\n终转能力：攻击力大幅提升，攻击数量＋2。");
    register_card_info_island("odin", "[分类：直线类]\n基础能力：向前方发射1发强化穿透短矛（2倍伤害）。\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n三转能力：攻击力提升25%（2.5倍伤害）。\n\n四转能力：伤害提升至3.75倍。\n\n终转能力：伤害提升至5倍。");
    register_card_info_island("fire_god", "[分类：增幅类]\n基础能力：穿过后变成高温子弹，并且伤害能力得到飞升，冰弹无效。\n *星级影响[攻击提升倍率]，技能影响[冷却时间]。\n\n三转能力：伤害再度提升20%。\n\n四转能力：被火子弹击中后，对当前格的敌人附加50%火焰群伤\n\n终转能力：增幅倍率再次提升20%，被火子弹击中后，对3×3范围内的敌人\n附加80%火焰群伤，\n*被直接击中的目标也会受到该伤害。");
    register_card_info_island("water_god", "[分类：增幅类]\n基础能力：将大多数命中自己的直射子弹反弹至相反的方向，并使它们的伤\n害增加[攻击力]点。每个子弹只能被反弹一次。\n *星级影响[攻击力]和[生命值]，技能影响[冷却时间]。\n\n三转能力：[能量消耗]降低至75。\n\n四转能力：[攻击力]额外增加。\n\n终转能力：反弹子弹伤害翻倍。");
    register_card_info_island("power_god", "[分类：追踪类]\n基础能力：发射两发强力子弹追踪攻击空中鼠军\n\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n三转能力：威力提升35%，定身加强。\n\n四转能力：增加1发子弹。\n\n终转能力：再增加一发子弹且触发灰烬效果。");
    register_card_info_island("sheng_huo", "[分类：喷壶类]\n基础能力：施展火焰术，向前方3行释放神圣穿透型火焰，灼烧沿途鼠军\n\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n三转能力：伤害大幅度提升, 几率眩晕,灰烬效果。\n\n四转能力：可伤害老鼠类型增加空中和地下。\n\n终转能力：同类卡片可提升伤害，几率产生暴烈一击。");
    register_card_info_island("save_god", "[分类：炸弹类]\n基础能力：化身为4条灵鱼，冲撞沿途遇到的老鼠\n\n *星级影响[冷却时间]，技能影响[攻击力]。\n\n三转能力：无需格子。\n\n四转能力：增加2条灵鱼，几率清理障碍。\n\n终转能力：增加2条灵鱼，清理遇到的路障。");
    register_card_info_island("joker", "[分类：直线类]\n基础能力：连续发射3发带有溅射效果的子弹，先后攻击本行\n\n空、地、水陆老鼠\n\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n三转能力：溅射伤害提升，死亡蝙蝠效果。\n\n四转能力：增加1发子弹。\n\n终转能力：溅射伤害提升。");
    register_card_info_island("ymir", "[分类：投掷类]\n基础能力：向前方三行投出共6发巨锤，带有45%溅射伤害。\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n三转能力：中路增加一发巨锤，攻击力提升10%，溅射伤害提升至50%。\n\n四转能力：侧路各增加一发巨锤，攻击力再提升10%，击杀附带灰烬效果\n\n终转能力：每路增加一发巨锤，攻击力再额外提升20%");
    register_card_info_island("xiangshui_god", "[分类：增幅类]\n基础能力：为周围绿地追踪卡片提升大幅攻击力，同类卡片效果不叠加。\n *星级影响[攻击力]（倍率=攻击力/100），技能影响[冷却时间]。\n\n三转能力：攻击力提升。\n\n四转能力：冰神类卡片共享增幅。\n\n终转能力：范围扩大至5x7，增幅倍数大幅提升，同类卡片加成可叠加2次。");
    register_card_info_island("fengrao_god", "[分类：增幅类]\n基础能力：为5*5范围内五向类卡片增加攻击力，倍率为[攻击力]/100。\n *星级影响[攻击力]（倍率=攻击力/100），技能影响[冷却时间]。\n\n三转能力：追加多向类卡片增幅，五向及多向类卡片均可增幅。\n\n四转能力：[攻击力]大幅提升，增幅倍率显著增加。\n\n终转能力：同类卡片加成可叠加2次（倍率相加）。");
    register_card_info_island("houyi_god", "[分类：直线类]\n基础能力：向前方3路发射3发穿透箭矢（3倍伤害），一定几率产生三昧真火灼烧鼠军。\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n一转能力：灼烧效果提升，中路子弹4倍伤害，边路3倍。\n\n二转能力：全弹4倍伤害，子弹击杀化为灰烬。\n\n终转能力：全弹5倍伤害，三昧真火叠加伤害翻倍。");
    register_card_info_island("heian_god", "[分类：追踪类]\n基础能力：对周围5*5范围内的敌人造成[攻击力]伤害，\n15%几率冰冻3秒。\n *星级影响[攻击力]，技能影响[持续时间]。\n\n三转能力：攻击间隔缩短。\n\n四转能力：攻击范围扩大至5*7，攻击力大幅提升。\n\n终转能力：连续命中同一敌人伤害递增\n（1x→1x→1.5x→2x→3x→atk*命中次数）。");
    register_card_info_island("gongjiang_god", "[分类：固定轨迹类]\n基础能力：发射1发河豚子弹（4倍伤害）沿固定轨迹往返，\n可攻击地下/陆地/飞行老鼠。\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n一转能力：子弹威力提升，25%概率附加河豚毒素，\n20%概率定身1.5秒。\n\n二转能力：子弹威力提升至5倍，25%概率释放河豚毒素。\n\n终转能力：第1、2列增加上下竖向子弹，\n30%概率附加河豚毒素。");
    register_card_info_island("hundun_god", "[分类：炸弹类]\n基础能力：吞噬5*5范围内的普通敌人（秒杀），\n对精英敌人造成4500伤害，死亡时产生3*3灰烬爆炸。\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n三转能力：吞噬范围扩大，精英伤害提升至6000，\n死亡爆炸范围5*5。\n\n四转能力：上古神·混沌，纵向吞噬范围扩大，\n同时吞噬多个敌人。\n\n终转能力：至尊上古神，自身右侧为中心5×7范围吞噬普通鼠军，\n对精英鼠造成9000伤害，死亡时产生5×5灰烬爆炸。");
    register_card_info_island("guangming_god", "[分类：追踪类]\n基础能力：每隔一段时间在自身周围召唤5*5格圣光，\n每次攻击持续2.1秒造成10次伤害，击杀敌人产生灰烬。\n *星级影响[攻击力]，技能影响[攻击间隔]。\n *无法攻击任意状态非主流鼠。\n\n三转能力：每放置1次黑暗神，最近的5个三转及以上光明神\n产生3*3范围1100伤害光影爆炸，灰烬非精英鼠。\n\n四转能力：黑暗神存在时光圣伤害提升至4倍；\n放置黑暗神触发最近7个光明神产生5*5范围1500伤害光影爆炸。\n\n终转能力：范围扩大至7*7；非终转黑暗神在场时5倍伤害，\n终转黑暗神在场时8倍伤害；放置黑暗神触发5*7范围2000伤害爆炸\n（双方均为终转时7*7范围3000伤害）。");
    register_card_info_island("mozhang", "[分类：增幅类]\n基础能力：为周围3*3范围内的旋转攻击卡片和本行直线喷射类卡片\n提升攻击力，倍率为[攻击力]/100。\n *星级影响[攻击力]，技能影响[冷却时间]。\n\n一转能力：旋转类卡片加成范围扩大到5*5。\n\n二转能力：[攻击力]大幅提升，旋转类加成范围5*5。");
    register_card_info_island("lingrong_god", "[分类：承载类]\n基础能力：三合一承载卡片，可在海底、陆地、水面、岩浆上\n承载卡片并填补空洞。\n *星级影响[冷却时间]。\n\n三转能力：竖向生成三张，三合一承载卡片。\n\n四转能力：直接生成九张，三合一承载卡片。");
    register_card_info_island("12yinliao", "[分类：增幅类]\n基础能力：每隔[攻击间隔]秒释放全屏美食，立即将体力回满。\n *对老鼠不造成伤害。\n *星级影响[冷却时间]，技能无影响。");
    
    register_card_info_island("dandantu", "[分类：增幅类]\n基础能力：储存3x3范围内子弹伤害，按[攻击力]%比例储存（上限3000），\n死亡或铲除时从屏幕左边召唤穿透型子弹攻击整行老鼠。\n储存达上限20%时70%几率头顶蛋成长一次。\n *星级影响[攻击力]和[冷却时间]。\n\n一转能力：存伤上限提升至6000。\n\n二转能力：作用行数提升至3行。");
    register_card_info_island("laipishe", "[分类：固定轨迹类]\n基础能力：无论场上是否有鼠军，每隔[攻击间隔]秒召唤一发海胆子弹，\n子弹沿固定路线经过(9,7)和(9,1)后返回原格，对沿途海陆空敌人造成[攻击力]点伤害。\n -同一发子弹对同一目标只造成一次伤害\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n一转能力：生成一发200%伤害海胆子弹。\n\n二转能力：生成一发300%伤害海胆子弹，子弹击杀目标后附加泡沫减速效果。");
    register_card_info_island("nizhuanniu", "[分类：增幅类]\n基础能力：将自身周围3*3范围内的普通老鼠逆转到其所在行的出生位置（最右边）。\n *星级影响[卡片冷却速度]，该防御卡不支持技能。\n *对boss、鼹鼠无效。\n\n一转能力：被逆转的老鼠额外受到1000点物理伤害。\n\n二转能力：逆转范围扩大到5*5。");
    register_card_info_island("shegengbao", "[分类：增幅类]\n基础能力：无需格子，对准想要回收能量的格子种卡，返还该格全部卡片的火苗能量。\n *星级影响[卡片冷却速度]，该防御卡不支持技能。\n\n一转能力：放置不消耗能量。\n\n二转能力：返还能量翻倍。");

    register_card_info_island("zhiyumiao", "[分类：增幅类]\n基础能力：为5*5范围内卡片瞬间恢复50点体力。\n *星级影响[冷却时间]，该防御卡不支持技能。\n\n一转能力：额外增加3秒补血Buff，体力提升至80。\n\n二转能力：全屏补血，保留3秒补血Buff。");
    register_card_info_island("wanpilong", "[分类：增幅类]\n基础能力：选择一张己方卡片，经过3.1秒前摇后，将其移动到周围5x5范围内的空格。\n移动保留卡片所有状态（血量、星级、冷却、增益等）。\n *星级影响[冷却时间]，该防御卡不支持技能强化。\n\n一转能力：移动范围扩大至全屏任意合法空格。\n\n二转能力：除卡片外，还可以移动己方角色到任意合法空格。");
    register_card_info_island("double_blade_snake", "[分类：直线类]\n基础能力：向前发射2发穿透剑气子弹，可斩杀生命值\n≤15%的普通老鼠。精英鼠触发斩杀时造成5倍子弹伤害。\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n一转能力：子弹数量+1。\n\n二转能力：子弹数量+1，斩杀阈值提升至25%，\n精英斩杀提升至10倍。");
    register_card_info_island("baobaoji", "[分类：增幅类]\n基础能力：部署时清除3×3范围内的路障、梯子和鼠洞。\n全天可部署，不造成伤害，清障不消耗体力。\n *星级影响[冷却时间]，该防御卡不支持技能。\n\n一转能力：耗能从275降至225，其他能力继承。\n\n二转能力：清除范围扩大到5×5，耗能保持225。");
    register_card_info_island("xuanfengniu", "[分类：增幅类]\n基础能力：吹走全屏特定空中老鼠。\n全天可部署，不造成伤害，吹走不产生击杀奖励。\n *星级影响[卡片冷却速度]，该防御卡不支持技能。\n\n一转能力：额外吹走全屏老鼠产生的障碍物，并兼容清障（老鼠洞、飞猪、海胆、梯子、弹簧）。\n\n二转能力：不需要格子，不占用网格容量，仍消耗300耗能并拥有1000体力。");
    register_card_info_island("qingse_shishi", "[分类：炸弹类]\n基础能力：向前方3×3范围内的老鼠发起重击，造成[攻击力]\n点伤害。\n *星级影响[冷却时间]，该卡不支持技能强化。\n\n一转能力：召唤3个柿子同时发起重击，竖向分布，\n伤害可叠加。\n\n二转能力：召唤5个柿子同时发起重击，可攻击空中敌人。");
    register_card_info_island("anranxiaohunfan", "[分类：增幅类]\n基础能力：放置后复活3×3范围内1个死亡的美食卡片，保留原卡片的星级、形态和技能状态。\n *星级影响[冷却时间]，该卡不支持技能。\n\n一转能力：耗能降低。\n\n二转能力：复活数量提升至2个。");
    register_card_info_island("liehuohu", "[分类：产能类]\n基础能力：每隔[攻击间隔]秒生产1朵价值为[火苗产量]的火苗，\n火苗先进入储能，点击收集后返还玩家；\n卡片消失时一次性返还剩余储能。储能上限1500。\n *星级影响[攻击间隔]。\n\n一转能力：每次同时生产2朵火苗。\n\n二转能力：每次同时生产2朵火苗，\n储能上限提升至3000。");
    register_card_info_island("panduola_god", "[分类：炸弹类]\n基础能力：放下后立即产生3×3范围灰烬爆炸，\n造成[攻击力]点伤害，并在本行留下3次毒气伤害。\n *星级影响[攻击力]。\n\n一转能力：毒气伤害+35%。\n\n二转能力：毒气范围+1行，全屏8000灰烬爆炸，\n随后每1秒造成鼠疫伤害×3次。\n\n终转能力：全屏8000灰烬爆炸并造成三次鼠疫伤害。");
    register_card_info_island("chongsheng_god", "[分类：增幅类]\n基础能力：5*5范围内监听卡片死亡并复活，每隔[冷却时间]复活范围内死亡的卡片。\n首次触发复活时给范围内所有卡片施加减伤BUFF，复活上限4张。\n *星级影响[冷却时间]，技能影响[减伤效果]。\n\n三转能力：复活上限提升至6张，减伤效果增强。\n\n四转能力：复活上限6张，减伤BUFF持续时间延长。\n\n终转能力：范围扩大至5*7，复活上限提升至9张，减伤大幅增强。");
    register_card_info_island("haiyang_god", "[分类：增幅类]\n基础能力：为5×5范围内喷壶类、5×1范围内附加类、本行咖啡喷壶类\n卡片增伤，倍率为[攻击力]/100。\n *多个海洋女神的增幅不叠加，取最高倍率。\n *星级影响[攻击力]，技能影响[冷却时间]。\n\n三转能力：悬浮卡，不占用格子。\n\n四转能力：[攻击力]大幅提升。\n\n终转能力：场上满4张海洋女神后，增幅范围扩大至全屏。");
    register_card_info_island("zhanqima", "[分类：增幅类]\n基础能力：为5×5范围内所有卡片提高基础攻击力，倍率为[攻击力]/100，持续[攻击间隔]后消失。\n *多个战旗马的增幅不叠加，取最高倍率。\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n一转能力：不占用格子。\n\n二转能力：范围扩大至全屏，增幅提升。");
    register_card_info_island("shennong_god", "[分类：固定轨迹类]\n基础能力：召唤2只沿固定行轨迹移动的穿透神焰，攻击2行敌人，\n可攻击空中、地下单位，击杀敌人产生灰烬。\n *场上炎帝数量大于7时，增加一行攻击轨迹。\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n三转能力：攻击力提升，神焰伤害增强。\n\n四转能力：攻击力大幅提升。");

    // 跨服远征感染敌人情报岛信息
    register_enemy_info_island("infected_normal_mouse", "平民僵尸鼠：被感染的普通老鼠，无特殊能力。");
    register_enemy_info_island("infected_football_fan_mouse", "球迷僵尸鼠：被感染的球迷鼠，生命值稍高。");
    register_enemy_info_island("infected_iron_pan_mouse", "铁锅僵尸鼠：被感染的铁锅鼠，生命值较高。");
    register_enemy_info_island("infected_skateboard_mouse", "滑板僵尸鼠：被感染的滑板鼠，速度快且能跳过卡片。");
    register_enemy_info_island("infected_landlady_mouse", "房东僵尸鼠：被感染的房东鼠，能抵挡直射子弹。");
    register_enemy_info_island("infected_kangaroo", "跳跳僵尸鼠：被感染的跳跳鼠，能连续跳过卡片。");
    register_enemy_info_island("infected_roller_skating_mouse", "轮滑僵尸鼠：被感染的轮滑鼠，生命值极高且速度快。");
    register_enemy_info_island("infected_giant_mouse", "巨型僵尸鼠：被感染的巨人鼠，生命值和伤害极高。");
    register_enemy_info_island("infected_panda_mouse", "熊猫僵尸鼠：被感染的熊猫鼠，会投出小熊猫僵尸鼠。\n生命值降低至一半时，如果自身在第五列之外，则会向第3或4列投掷一只生命值为100的小熊猫鼠。");
    register_enemy_info_island("infected_little_panda_mouse", "小熊猫僵尸鼠：由熊猫僵尸鼠投掷出的小熊猫僵尸鼠。");
    register_enemy_info_island("infected_paper_boat_mouse", "纸船僵尸鼠：被感染的纸船鼠，无特殊能力。");
    register_enemy_info_island("infected_duck_mouse", "鸭子泳圈僵尸鼠：被感染的鸭子泳圈鼠，生命值稍高。");
    register_enemy_info_island("infected_tropical_fish_mouse", "热带鱼泳圈僵尸鼠：被感染的热带鱼泳圈鼠，生命值较高。");
    register_enemy_info_island("infected_diver_mouse", "潜水僵尸鼠：被感染的潜水鼠，不攻击时潜在水面下。");
    register_enemy_info_island("infected_frog_prince_mouse", "青蛙王子僵尸鼠：被感染的青蛙王子鼠，可越过障碍。");
    register_enemy_info_island("infected_submarine_mouse", "水潜艇僵尸鼠：被僵尸鼠操控的水潜艇，装甲完整且不攻击时潜水。");
    register_enemy_info_island("infected_mario_mouse", "变异洞君：被感染后变得更加强大的洞君。\n洞君会在地图右侧出场，并使用下列技能的随机一个，随后消失。\n技能1：洞君会在地图第9列挖掘一个坑洞，并在4-7列的范围内随机生成三个生命值为600的管道，进入坑洞的老鼠会被传送到管道处。\n技能2：洞君会进行3次跳跃，依次摧毁本行第8、6、4列的三张卡片。");
    register_enemy_info_island("infected_arno", "变异阿诺：被感染后变得更加强大的阿诺。\n阿诺会在地图右侧出场，并使用下列技能的随机一个，随后消失。\n技能1：阿诺发射两颗子弹，摧毁本行最左侧的两张卡片。\n技能2：阿诺在较长前摇后冲刺，摧毁本行右侧7列的卡片。");
    register_enemy_info_island("infected_fire_residue", "感染火渣：被感染的火渣，掌控火焰之力。");
    register_enemy_info_island("infected_zhanshen", "变异战神：被感染后变得更加强大的战神。\n战神会在第4行出场，出场时会同时在第2行和第6行分别生成一个生命值为150000的木鸭，木鸭每隔30秒会发射一个木轮，摧毁本行卡片。\n战神会持续向左侧移动，每隔18秒会停止，并使用一次技能。\n技能1：战神在本行左侧一格和本列上下两行中分别召唤一个生命值为1000的战士鼠。\n技能2：战神在召唤战士鼠的基础上，还会释放一个生命值为1800的滚木，滚木会摧毁三行内的卡片。\n战神会使用1-2的技能循环。");
    register_card_info_island("hongliukaochuan", "[分类：喷壶类]\n基础能力：全屏索敌发射追踪穿透串，攻击陆地、空中和幽灵类老鼠。\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n一转能力：攻击力提高。\n\n二转能力：攻击力翻倍。");

    // 融合卡
    register_card_info_island("lizi_god", "[分类：投掷类]\n基础能力：向前方投掷一颗烤栗子，落地后产生3×3范围的灼烧效果，持续造成10次[攻击力]点伤害。\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n初级融合能力：攻击间隔大幅缩短，攻击力提升，射程增加。\n\n深度融合能力：灼烧范围扩大至5×5，伤害范围显著增加。\n\n灵魂融合能力：向前方三行各投掷一颗烤栗子，灼烧范围扩大至5×7。");
    register_card_info_island("youyu_god", "[分类：多向类]\n基础能力：向八个方向各发射一发鱿鱼弹，攻击陆地、空中和幽灵类老鼠。需放置在章鱼烧上。\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n初级融合能力：无需章鱼烧底座即可独立部署。\n\n深度融合能力：前后路各追加两发水平弹道，中路水平子弹可触发火焰增幅。\n\n灵魂融合能力：二十二发鱿鱼弹齐射，火力全面覆盖战场。");
    register_card_info_island("ronghehaixing", "[分类：多向类]\n基础能力：同时发射五发不同方向的海星刺身弹，可被水神反弹并提升伤害，能携带上岸攻击。\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n初级融合能力：子弹命中敌人后按比例扩散伤害。\n\n深度融合能力：扩散伤害比例提升。\n\n灵魂融合能力：追踪弹命中敌人后追加额外伤害，攻击力大幅提升。");
    register_card_info_island("ronghedan_god", "[分类：投掷类]\n基础能力：向前方投掷两枚臭豆腐煮蛋，命中敌人造成[攻击力]点伤害，并对周围敌人造成35%溅射伤害。子弹有20%概率定身敌人。\n *星级影响[攻击力]，技能影响[攻击间隔]。\n\n初级融合能力：溅射伤害提升至50%，定身概率和持续时间提升，溅射伤害也可附带定身。\n\n深度融合能力：子弹爆炸后附加毒伤效果，持续造成毒素伤害。\n\n灵魂融合能力：向前方三行各投掷两枚煮蛋，攻击力大幅提升。");
}
